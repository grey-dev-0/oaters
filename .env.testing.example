APP_NAME=OATERS
APP_ENV=testing
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=error

# Test database used by the PHPUnit suite. Module migrations require MySQL/MariaDB
# (uuid_short() defaults in r_subordinates), so sqlite in-memory cannot be used.
# Copy this file to .env.testing and point it at a disposable database — every test
# run executes migrate:fresh against it and erases all of its data.
DB_CONNECTION=mysql
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=oaters_test
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=array
CACHE_DRIVER=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array
